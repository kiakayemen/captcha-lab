# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

DJANGO_DEBUG=false

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=UTC

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_TRUST_PROXY_SSL=false


# ---------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=UTC


# ---------------------------------------------------------
# Scraper
# ---------------------------------------------------------

SCRAPER_HEADLESS=true
SCRAPER_GPU=false
SCRAPER_OUTPUT_DIR=output/live_solver

CAPTCHA_LOG_LEVEL=INFO


# ---------------------------------------------------------
# Notifications
# Configure later with team lead
# ---------------------------------------------------------

APPOINTMENT_SMTP_HOST=
APPOINTMENT_SMTP_PORT=587
APPOINTMENT_SMTP_SECURITY=starttls
# Optional: certificate/SNI hostname if it differs from APPOINTMENT_SMTP_HOST.
APPOINTMENT_SMTP_TLS_SERVER_NAME=

APPOINTMENT_NOTIFICATION_ATTEMPTS=3
APPOINTMENT_NOTIFICATION_RETRY_SECONDS=2
