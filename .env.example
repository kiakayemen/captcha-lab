# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
DJANGO_SQLITE_PATH=/app/data/db.sqlite3
DJANGO_STATIC_ROOT=/app/staticfiles

DJANGO_TIME_ZONE=UTC

DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_TRUST_PROXY_SSL=false


# ---------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=UTC


# ---------------------------------------------------------
# Scraper
# ---------------------------------------------------------

SCRAPER_HEADLESS=true
SCRAPER_GPU=false
SCRAPER_OUTPUT_DIR=output/live_solver

BLS_EMAIL=
BLS_PASSWORD=
LOGIN_URL=https://example.invalid/

# Container/runtime tuning
PORT=8000
WEB_CONCURRENCY=2
WEB_TIMEOUT=120
CELERY_LOG_LEVEL=info
CELERY_POOL=solo
CELERY_CONCURRENCY=1

CAPTCHA_LOG_LEVEL=INFO


# ---------------------------------------------------------
# Notifications
# Configure later with team lead
# ---------------------------------------------------------

APPOINTMENT_SMTP_HOST=
APPOINTMENT_SMTP_PORT=587
APPOINTMENT_SMTP_SECURITY=starttls
# Optional: certificate/SNI hostname if it differs from APPOINTMENT_SMTP_HOST.
APPOINTMENT_SMTP_TLS_SERVER_NAME=
APPOINTMENT_SMTP_USERNAME=
APPOINTMENT_SMTP_PASSWORD=
APPOINTMENT_EMAIL_FROM=
APPOINTMENT_EMAIL_TO=
APPOINTMENT_SMTP_TIMEOUT_SECONDS=15

APPOINTMENT_NOTIFICATION_ATTEMPTS=3
APPOINTMENT_NOTIFICATION_RETRY_SECONDS=2
APPOINTMENT_WEBHOOK_URL=
APPOINTMENT_WEBHOOK_TIMEOUT_SECONDS=15
